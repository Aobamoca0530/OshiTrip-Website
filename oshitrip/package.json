{
  "name": "oshitrip",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "package:windows": "node scripts/package-windows.mjs",
    "package:cleanup": "node scripts/package-cleanup.mjs",
    "test:cleanup": "node scripts/test-cleanup.mjs",
    "data:publish": "node scripts/publish-data.mjs",
    "data:check": "node scripts/publish-data.mjs --check",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "seed:sql": "node scripts/generate-seed.mjs && node scripts/generate-setup-sql.mjs",
    "crawl:check": "node --env-file-if-exists=.env.local scripts/check-crawler-config.mjs",
    "crawl:releases": "node scripts/crawl-releases.mjs",
    "crawl:public": "node --env-file-if-exists=.env.local scripts/crawl-public.mjs",
    "crawl:replay": "node --env-file-if-exists=.env.local scripts/crawl-public.mjs --replay",
    "ai:check": "node --env-file-if-exists=.env.local scripts/check-ai-config.mjs",
    "maintain:public": "node --env-file-if-exists=.env.local scripts/maintain-public.mjs",
    "build:mobile": "vite build --config mobile/vite.config.ts && node scripts/mobile-service-worker.mjs",
    "dev:mobile": "vite --config mobile/vite.config.ts --host 127.0.0.1",
    "package:mac": "node scripts/package-mac.mjs",
    "android:sync": "pnpm build:mobile && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "0.5.11",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "prettier": "3.9.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
