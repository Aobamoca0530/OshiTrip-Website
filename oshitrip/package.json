{
  "name": "oshitrip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "seed:sql": "node scripts/generate-seed.mjs && node scripts/generate-setup-sql.mjs",
    "crawl:check": "node --env-file-if-exists=.env.local scripts/check-crawler-config.mjs",
    "crawl:releases": "node scripts/crawl-releases.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/supabase-js": "2.118.0",
    "zod": "4.6.7",
    "lucide-react": "1.61.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "10.13.0",
    "@next/eslint-plugin-next": "16.4.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "@electric-sql/pglite": "0.5.11",
    "prettier": "3.9.0"
  }
}
