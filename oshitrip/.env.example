# Leave both blank for the local, manually verified snapshot.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional crawler worker ONLY (GitHub Actions secret). Never prefix this with NEXT_PUBLIC.
# The public Next.js app and manual admin do not require it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Optional server-side image transcription/translation: Bailian or OpenAI vision.
# Off by default; extracts to review queue, never publishes automatically.
CRAWLER_IMAGE_RULES=false
IMAGE_RULE_PROVIDER=
DASHSCOPE_API_KEY=
# Beijing region; use the official workspace-specific Base URL if provided in your console.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
IMAGE_RULE_MODEL=
# Per-run paid image calls (1–16), and HTML pages per source (1–30).
CRAWLER_IMAGE_LIMIT=4
CRAWLER_PAGE_LIMIT=3
# Optional comma-separated IDs from scripts/crawler/sources.json.
CRAWLER_SOURCE_IDS=sweets-paradise

# Public activity translation and independent review (worker only; never in EXE).
# auto: first configured OpenAI, then Bailian, then DeepSeek. No key => assistant queue.
# Explicit choices never silently fall back on an API error. manual disables API calls.
DEEPSEEK_API_KEY=
EVENT_TRANSLATION_PROVIDER=auto
EVENT_TRANSLATION_MODEL=
EVENT_TRANSLATION_LIMIT=24
EVENT_REVIEW_PROVIDER=auto
EVENT_REVIEW_MODEL=
EVENT_REVIEW_LIMIT=24
# Optional per-provider model defaults; task-specific model takes precedence.
OPENAI_MODEL=gpt-4.1-mini
BAILIAN_MODEL=qwen-plus
DEEPSEEK_MODEL=deepseek-flash
